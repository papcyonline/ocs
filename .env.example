# Resend API key for contact form emails
# 1. Sign up at https://resend.com
# 2. Verify the ottri.net domain (or use the test domain `onboarding@resend.dev`)
# 3. Create an API key and paste it below
# 4. Copy this file to .env.local and set the value
RESEND_API_KEY=

# Twilio credentials for SMS + WhatsApp booking notifications
# TWILIO_FROM is the Twilio phone number used for both SMS and WhatsApp (E.164 format)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+18563865313
