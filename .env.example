# Resend API key for contact form emails
# 1. Sign up at https://resend.com
# 2. Verify the ottri.net domain (or use the test domain `onboarding@resend.dev`)
# 3. Create an API key and paste it below
# 4. Copy this file to .env.local and set the value
RESEND_API_KEY=

# Twilio credentials for SMS + WhatsApp booking notifications
# TWILIO_FROM is the Twilio phone number used for both SMS and WhatsApp (E.164 format)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+18563865313

# Google Search Console site verification (HTML tag method)
# 1. Go to https://search.google.com/search-console and add the ottri.net property
# 2. Choose the "HTML tag" verification method
# 3. Copy ONLY the content value from the <meta name="google-site-verification" ...> tag
# 4. Paste it below, redeploy, then click "Verify" in Search Console
GOOGLE_SITE_VERIFICATION=

# (Optional) Bing Webmaster Tools verification — the content value of the
# <meta name="msvalidate.01" ...> tag from https://www.bing.com/webmasters
BING_SITE_VERIFICATION=
